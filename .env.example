# Copy this file to .env and fill in the values. .env is ignored by git.
# Gemini API key (free tier, from aistudio.google.com) for generating speech with `npm run speech`.
GEMINI_API_KEY=
# ElevenLabs API key (free plan, from elevenlabs.io) for the voice trial: `npm run speech -- --samples`.
ELEVENLABS_API_KEY=
